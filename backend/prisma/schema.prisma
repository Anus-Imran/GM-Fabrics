generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  CREDIT
}

enum SaleStatus {
  PENDING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum KhataEntryType {
  SALE
  PAYMENT
  RETURN
  VOID
  ADJUSTMENT
}

enum StockAdjustmentReason {
  DAMAGE
  SHRINKAGE
  COUNT_CORRECTION
  FOUND
  OPENING
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum SupplierReturnType {
  RETURN // goods go back for good — supplier balance is reduced
  REPLACEMENT // goods go back, supplier will send replacements
}

enum SupplierReturnStatus {
  COMPLETED // plain return, settled
  PENDING_REPLACEMENT
  PARTIALLY_REPLACED
  REPLACED
  CONVERTED // replacement that was turned into a return for the unreplaced quantity
}

// 1. Users & Auth
model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  password         String
  role             Role              @default(CASHIER)
  isActive         Boolean           @default(true)
  sales            Sale[]            @relation("SaleCashier")
  voidedSales      Sale[]            @relation("SaleVoidedBy")
  expenses         Expense[]
  notes            Note[]
  returns          Return[]
  khataEntries     KhataEntry[]
  stockAdjustments StockAdjustment[]
  supplierPayments SupplierPayment[]
  supplierReturns  SupplierReturn[]
  openedSessions   CashSession[]     @relation("SessionOpenedBy")
  closedSessions   CashSession[]     @relation("SessionClosedBy")
  auditLogs        AuditLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// 2. Units (guzz, metre, kg, grams, pieces, etc.)
model Unit {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  symbol       String?
  allowDecimal Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
}

// 3. Categories (Lawn, Cotton, Silk, Chiffon, Linen...)
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 4. Brands (Gul Ahmed, Bonanza, Al-Karam, Sapphire...)
model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  country   String?
  notes     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 5. Suppliers
model Supplier {
  id           Int               @id @default(autoincrement())
  name         String
  phone        String?
  address      String?
  city         String?
  notes        String?
  products     Product[]
  stockEntries StockEntry[]
  payments     SupplierPayment[]
  returns      SupplierReturn[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// 6. Products
model Product {
  id            Int          @id @default(autoincrement())
  name          String
  sku           String?      @unique
  barcode       String?      @unique
  description   String?

  categoryId    Int
  category      Category     @relation(fields: [categoryId], references: [id])
  brandId       Int?
  brand         Brand?       @relation(fields: [brandId], references: [id])
  unitId        Int
  unit          Unit         @relation(fields: [unitId], references: [id])

  supplierId    Int?
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])

  costPrice     Float        @default(0)
  salePrice     Float        @default(0)

  stockQuantity Float        @default(0)
  lowStockAlert Float        @default(10)

  isActive      Boolean      @default(true)

  stockEntries     StockEntry[]
  stockBatches     StockBatch[]
  saleItems        SaleItem[]
  returnItems      ReturnItem[]
  stockAdjustments StockAdjustment[]
  supplierReturns  SupplierReturn[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([isActive, name])
  @@index([categoryId])
}

// 7. Stock Entries (Inventory Purchases & Price Change Tracking)
model StockEntry {
  id                  Int          @id @default(autoincrement())
  productId           Int
  product             Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId          Int?
  supplier            Supplier?    @relation(fields: [supplierId], references: [id])

  invoiceNumber       String?

  quantity            Float
  costPerUnit         Float
  totalCost           Float

  previousCostPerUnit Float?
  priceDiff           Float?

  notes               String?
  purchasedAt         DateTime     @default(now())
  createdAt           DateTime     @default(now())
  stockBatches        StockBatch[]
  supplierReturns     SupplierReturn[]

  @@index([productId])
  @@index([supplierId])
  @@index([purchasedAt])
  @@index([invoiceNumber])
}

// 7.1 Stock Batches (FIFO Inventory Lot Tracking)
model StockBatch {
  id                Int               @id @default(autoincrement())
  productId         Int
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockEntryId      Int?
  stockEntry        StockEntry?       @relation(fields: [stockEntryId], references: [id], onDelete: SetNull)

  initialQuantity   Float
  remainingQuantity Float
  costPrice         Float
  sellingPrice      Float             @default(0)
  returnedQuantity  Float             @default(0) // sent back to the supplier and not replaced

  saleItems         SaleItem[]
  adjustments       StockAdjustment[]
  supplierReturns   SupplierReturn[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([productId, remainingQuantity])
  @@index([stockEntryId])
}

// 7.2 Stock Adjustments (damage, shrinkage, stock-count corrections) — every manual stock change is recorded here
model StockAdjustment {
  id         Int                   @id @default(autoincrement())
  productId  Int
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId    Int?
  batch      StockBatch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity   Float // signed: positive adds stock, negative removes stock
  costPrice  Float                 @default(0)
  reason     StockAdjustmentReason
  notes      String?
  userId     Int?
  user       User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())

  @@index([productId])
  @@index([createdAt])
}

// 8. Customers
model Customer {
  id                 Int          @id @default(autoincrement())
  name               String
  phone              String?      @unique
  cnic               String?      @unique
  address            String?
  notes              String?
  outstandingBalance Float        @default(0)
  sales              Sale[]
  khataEntries       KhataEntry[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([name])
}

// 8.1 Khata Ledger — every change to a customer's outstanding balance
model KhataEntry {
  id           Int            @id @default(autoincrement())
  customerId   Int
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         KhataEntryType
  amount       Float // signed: positive increases what the customer owes, negative reduces it
  balanceAfter Float
  method       PaymentMethod?
  saleId       Int?
  sale         Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  returnId     Int?
  notes        String?
  userId       Int?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([customerId, createdAt])
  @@index([createdAt])
}

// 9. Sales
model Sale {
  id             Int           @id @default(autoincrement())
  saleNumber     String        @unique

  customerId     Int?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  userId         Int
  user           User          @relation("SaleCashier", fields: [userId], references: [id])

  subtotal       Float
  discountType   String?
  discountValue  Float         @default(0)
  discountAmount Float         @default(0)
  totalAmount    Float

  paymentMethod  PaymentMethod @default(CASH)
  amountPaid     Float
  changeAmount   Float         @default(0)
  creditAmount   Float         @default(0) // portion of the bill added to the customer's khata

  status         SaleStatus    @default(COMPLETED)
  notes          String?

  voidedAt       DateTime?
  voidedById     Int?
  voidedBy       User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidReason     String?

  saleItems      SaleItem[]
  receipt        Receipt?
  returns        Return[]
  khataEntries   KhataEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([userId])
}

// 10. Sale Items
model SaleItem {
  id          Int          @id @default(autoincrement())
  saleId      Int
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product      @relation(fields: [productId], references: [id])
  batchId     Int?
  batch       StockBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  quantity    Float
  costPrice   Float        @default(0)
  listPrice   Float        @default(0) // catalog / lot price before the cashier's per-unit discount
  unitPrice   Float
  subtotal    Float

  returnItems ReturnItem[]
  createdAt   DateTime     @default(now())

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
}

// 11. Receipts (HTML is generated on demand; the row tracks printing)
model Receipt {
  id          Int       @id @default(autoincrement())
  saleId      Int       @unique
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  receiptHtml String?   @db.Text
  printCount  Int       @default(0)
  lastPrintAt DateTime?
  createdAt   DateTime  @default(now())
}

// 12. Expense Categories
model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

// 13. Expenses
model Expense {
  id         Int             @id @default(autoincrement())
  title      String
  categoryId Int
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount     Float
  date       DateTime        @default(now())
  fromDrawer Boolean         @default(false) // paid out of the counter cash drawer
  notes      String?
  userId     Int?
  user       User?           @relation(fields: [userId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([date])
}

// 14. Returns
model Return {
  id           Int           @id @default(autoincrement())
  saleId       Int
  sale         Sale          @relation(fields: [saleId], references: [id])
  reason       String?
  refundAmount Float
  refundMethod PaymentMethod @default(CASH)
  userId       Int?
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  returnItems  ReturnItem[]
  createdAt    DateTime      @default(now())

  @@index([saleId])
  @@index([createdAt])
}

// 15. Return Items
model ReturnItem {
  id           Int      @id @default(autoincrement())
  returnId     Int
  return       Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId   Int
  saleItem     SaleItem @relation(fields: [saleItemId], references: [id])
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])

  quantity     Float
  refundAmount Float
  condition    String   @default("RESTOCK")
  createdAt    DateTime @default(now())

  @@index([saleItemId])
  @@index([returnId])
}

// 16. Supplier Payments (payables: purchases minus payments = amount owed to supplier)
model SupplierPayment {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Float
  method     String   @default("CASH") // CASH | BANK | CHEQUE | OTHER
  reference  String?
  fromDrawer Boolean  @default(false)
  notes      String?
  paidAt     DateTime @default(now())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([supplierId, paidAt])
}

// 16.1 Supplier Returns (purchase returns & replacements) — stock leaves a specific purchase lot
model SupplierReturn {
  id               Int                  @id @default(autoincrement())
  supplierId       Int
  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  productId        Int
  product          Product              @relation(fields: [productId], references: [id])
  stockEntryId     Int?
  stockEntry       StockEntry?          @relation(fields: [stockEntryId], references: [id], onDelete: SetNull)
  batchId          Int?
  batch            StockBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  type             SupplierReturnType
  status           SupplierReturnStatus
  quantity         Float
  replacedQuantity Float                @default(0)
  costPerUnit      Float
  creditAmount     Float                @default(0) // reduces what we owe the supplier
  refundReceived   Float                @default(0) // cash/bank the supplier paid back
  refundMethod     String?
  refundToDrawer   Boolean              @default(false)
  refundedAt       DateTime?

  reason           String?
  notes            String?
  userId           Int?
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  returnedAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([supplierId, returnedAt])
  @@index([status])
  @@index([batchId])
  @@index([refundedAt])
}

// 17. Cash Drawer Sessions (day open / day close / Z-report)
model CashSession {
  id           Int               @id @default(autoincrement())
  status       CashSessionStatus @default(OPEN)
  openingCash  Float             @default(0)
  openedAt     DateTime          @default(now())
  openedById   Int
  openedBy     User              @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedAt     DateTime?
  closedById   Int?
  closedBy     User?             @relation("SessionClosedBy", fields: [closedById], references: [id])
  expectedCash Float?
  countedCash  Float?
  difference   Float?
  summary      Json?
  notes        String?

  @@index([status])
  @@index([openedAt])
}

// 18. Audit Log — who changed what
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// 19. System Notifications
model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// 20. Notes & To-Do Items
model Note {
  id          Int       @id @default(autoincrement())
  title       String
  content     String?   @db.Text
  priority    String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  isCompleted Boolean   @default(false)
  color       String?   @default("yellow") // "yellow", "blue", "emerald", "purple", "rose"
  dueDate     DateTime?
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 21. Legacy AI Logs (unused by the app; kept so existing data is not dropped)
model AiLog {
  id         Int      @id @default(autoincrement())
  agent      String?
  input      String?  @db.Text
  output     String?  @db.Text
  tokensUsed Int?     @default(0)
  metadata   Json?
  prompt     String?  @db.Text
  response   String?  @db.Text
  createdAt  DateTime @default(now())
}
