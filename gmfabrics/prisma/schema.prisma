generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Fabric Categories (Jaise: Lawn, Cotton, Silk, Chiffon)
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// 2. Fabric Products (Yahan quantity Float rakhi hai taakh fractional meters/yards aa sakein)
model Product {
  id            Int        @id @default(autoincrement())
  name          String
  categoryId    Int
  category      Category   @relation(fields: [categoryId], references: [id])
  pricePerMeter Float      // Ek meter ya yard ki qeemat
  stockQuantity Float      // Stock mein kitna meter/yard bacha hai (e.g. 45.5 meters)
  barcode       String?    @unique
  saleItems     SaleItem[]
  createdAt     DateTime   @default(now())
}

// 3. Transactions (Har ek bill / sale ka record)
model Transaction {
  id          Int        @id @default(autoincrement())
  totalAmount Float
  createdAt   DateTime   @default(now())
  saleItems   SaleItem[]
}

// 4. Sale Items (Ek bill mein kaun sa fabric aur kitni quantity biki)
model SaleItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Float       // Kitna meter bika (e.g. 2.75 meters)
  subtotal      Float       // Is item ka total bill
}